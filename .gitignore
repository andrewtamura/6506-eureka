# Node / Vite
node_modules/
dist/
.vite/
*.log

# Python
.venv/
venv/
__pycache__/
*.pyc

# Derived runtime assets (regenerated by scripts/prepare-assets.mjs)
public/

# Cached measurement from tools/kitchen-check.mjs (--from replays it). Glob, not the
# bare name: --out names its own file, e.g. the full-scope run's .kitchen-check-full.json.
.kitchen-check*.json
